---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { writingByWork } from '../../lib/related-content';
import { withBase } from '../../lib/url';
import { formatDate, t } from '../../i18n';
import '../../styles/code-notations.css';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const relatedWriting = (await getCollection('writing', ({ data }) => !data.draft)).find(
  (post) => post.id === writingByWork[entry.id],
);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  image={withBase(`/og/work/${entry.id}.png`)}
>
  <article data-pagefind-body>
    <header class="page-head section article-head">
      <p class="eyebrow">{t('work.eyebrow')}</p>
      <h1>{entry.data.title}</h1>
      {entry.data.subtitle && <p class="article-subtitle">{entry.data.subtitle}</p>}
      <p class="lead">{entry.data.description}</p>
      <div class="entry-meta">
        {
          entry.data.period ? (
            <span>{entry.data.period}</span>
          ) : (
            <time datetime={entry.data.publishDate.toISOString()}>
              {formatDate(entry.data.publishDate)}
            </time>
          )
        }
        <span>{entry.data.tech.join(' / ')}</span>
      </div>
      {
        (entry.data.link || entry.data.repo) && (
          <div class="action-row">
            {entry.data.link && (
              <a class="button" href={entry.data.link}>
                {t('work.visit')}
              </a>
            )}
            {entry.data.repo && (
              <a class="text-link" href={entry.data.repo}>
                {t('work.repository')}
              </a>
            )}
          </div>
        )
      }
      {
        entry.data.thumbnail && (
          <Image
            class="article-image"
            src={entry.data.thumbnail}
            alt=""
            widths={[720, 1040, 1400]}
            sizes="(min-width: 900px) 72rem, 100vw"
          />
        )
      }
    </header>

    <div class="section article-layout">
      <TableOfContents headings={headings} />
      <div class="prose"><Content /></div>
    </div>
  </article>
  {
    relatedWriting && (
      <aside class="section related-context" aria-label="관련 기술 글">
        <p class="eyebrow">이 프로젝트의 기술 글</p>
        <a href={withBase(`/writing/${relatedWriting.id}/`)}>
          {relatedWriting.data.title} <span aria-hidden="true">→</span>
        </a>
        <p>{relatedWriting.data.description}</p>
      </aside>
    )
  }
</BaseLayout>
