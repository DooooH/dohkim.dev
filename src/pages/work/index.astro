---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { SITE } from '../../consts';

const work = (await getCollection('work')).sort((a, b) => {
  const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
  const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
  return orderA - orderB || b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<BaseLayout
  title="프로젝트"
  description={`${SITE.author}의 주요 백엔드 시스템 엔지니어링 프로젝트 및 성과입니다.`}
>
  <section class="page-head section">
    <p class="eyebrow">프로젝트</p>
    <h1>제약 조건에서 시작한 기술적 판단</h1>
    <p class="lead">
      권한, 비동기 상태, 관측성과 데이터 변환. 각 문제에서 바꾼 구조와 확인할 수 있는 결과를
      정리했습니다.
    </p>
  </section>

  <section class="section" aria-label="주요 프로젝트">
    <div class="project-grid">
      {work.map((item) => <WorkCard work={item} heading="h2" />)}
    </div>
  </section>
</BaseLayout>
