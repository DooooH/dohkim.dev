---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, readingTime } from '../i18n';

const selectedWriting = (await getCollection('writing'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const readingTimes = new Map(
  await Promise.all(
    selectedWriting.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return [post.id, readingTime(remarkPluginFrontmatter.minutesRead)] as const;
    }),
  ),
);

const selectedWork = (await getCollection('work'))
  .sort(
    (a, b) =>
      (a.data.order ?? 999) - (b.data.order ?? 999) ||
      b.data.publishDate.getTime() - a.data.publishDate.getTime(),
  )
  .slice(0, 4);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <section class="hero section editorial-hero">
    <div>
      <p class="eyebrow">김도형 · 백엔드 엔지니어</p>
      <h1>운영에서 드러난 문제를<br />명확한 경계로 바꿉니다.</h1>
      <p class="lead">
        권한과 상태, 시간과 데이터의 의미를 구분합니다. 문제를 좁힌 과정과 코드로 바꾼 판단을
        기록합니다.
      </p>
      <div class="action-row" aria-label="주요 링크">
        <a class="button" href={withBase('/work/')}
          >프로젝트 보기 <span aria-hidden="true">↗</span></a
        >
        <a class="text-link" href={withBase('/writing/')}>기술 글 읽기</a>
      </div>
    </div>
    <div class="hero-note">
      <p class="eyebrow">이 기록에서 다루는 것</p>
      <p>실패가 발생하는 조건.<br />선택한 변경의 이유.<br />검증한 범위와 남은 질문.</p>
      <a class="text-link" href={withBase('/about/')}
        >엔지니어 소개 <span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="selected-work">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2 id="selected-work">문제와 판단으로 읽는 프로젝트</h2>
      <a class="text-link" href={withBase('/work/')}
        >전체 프로젝트 보기 <span aria-hidden="true">→</span></a
      >
    </div>
    <div class="project-grid">
      {selectedWork.map((work) => <WorkCard work={work} />)}
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="selected-writing">
    <div class="section-heading">
      <p class="eyebrow">Engineering notes</p>
      <h2 id="selected-writing">한 문제를 깊게 들여다본 기록</h2>
      <a class="text-link" href={withBase('/writing/')}>전체 글 보기</a>
    </div>
    <div class="entry-list home-entry-list">
      {
        selectedWriting.map((post) => (
          <article class="entry-card">
            <div class="entry-meta">
              <time datetime={post.data.publishDate.toISOString()}>
                {formatDate(post.data.publishDate, 'short')}
              </time>
              <span>{readingTimes.get(post.id)}</span>
            </div>
            <h3>
              <a href={withBase(`/writing/${post.id}/`)}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
            <ul class="project-tags" aria-label="글 주제">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section prose-grid home-about" aria-labelledby="home-about">
    <div>
      <p class="eyebrow">소개</p>
      <h2 id="home-about">결론과 함께 판단 과정을 남깁니다.</h2>
    </div>
    <div class="prose-stack">
      <p>
        어떤 조건에서 문제가 생겼는지, 무엇을 바꾸었는지, 어디까지 확인했는지를 구분합니다. 다음
        사람이 같은 문제를 만났을 때 판단 과정을 다시 사용할 수 있도록 기록합니다.
      </p>
      <a class="text-link" href={withBase('/about/')}>소개 더 보기</a>
    </div>
  </section>
</BaseLayout>
