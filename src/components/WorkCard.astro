---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  work: CollectionEntry<'work'>;
  heading?: 'h2' | 'h3';
}

const { work, heading: Heading = 'h3' } = Astro.props;
const topics: Record<string, string> = {
  'fail-closed-authorization-boundary': '권한과 접근 제어',
  'async-batch-context-isolation': '비동기 실행과 상태',
  'subsecond-metric-pipeline': '관측성과 시간축',
  'telemetry-semantic-adapter': '데이터 변환과 호환성',
};
---

<article class="project-card">
  <div class="project-kicker">
    <span>{topics[work.id] ?? '백엔드 엔지니어링'}</span>
    {work.data.period && <span>{work.data.period}</span>}
  </div>
  <Heading><a href={withBase(`/work/${work.id}/`)}>{work.data.title}</a></Heading>
  <p class="project-description">{work.data.description}</p>
  <div class="project-footer">
    <ul class="project-tags" aria-label="사용 기술">
      {work.data.tech.map((tech) => <li>{tech}</li>)}
    </ul>
    <a class="project-read" href={withBase(`/work/${work.id}/`)}>
      <span class="sr-only">{work.data.title}: </span>사례 읽기 <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
