---
type CalloutType = 'note' | 'tip' | 'warning' | 'danger';

interface Props {
  type?: CalloutType;
  title?: string;
}

const { type = 'note', title } = Astro.props;
const labels: Record<CalloutType, string> = {
  note: 'Note',
  tip: 'Tip',
  warning: 'Warning',
  danger: 'Danger',
};
---

<aside class:list={['callout', `callout-${type}`]} role="note" aria-label={title ?? labels[type]}>
  <p class="callout-title">{title ?? labels[type]}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    --callout-color: var(--color-accent);
    margin-block: calc(var(--baseline) * 1.5);
    border: var(--hairline);
    border-left: 0.25rem solid var(--callout-color);
    padding: 1rem 1.15rem;
    background: var(--color-surface);
  }

  .callout-tip {
    --callout-color: oklch(0.58 0.13 155);
  }

  .callout-warning {
    --callout-color: oklch(0.7 0.15 80);
  }

  :root[data-theme='light'] .callout-warning .callout-title {
    color: oklch(0.45 0.14 65);
  }

  :root[data-theme='dark'] .callout-warning .callout-title {
    color: oklch(0.78 0.14 80);
  }

  .callout-danger {
    --callout-color: oklch(0.58 0.2 25);
  }

  .callout-title {
    margin: 0;
    color: var(--callout-color);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .callout-body {
    margin-top: 0.45rem;
  }

  .callout-body :global(> :first-child) {
    margin-top: 0;
  }

  .callout-body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
